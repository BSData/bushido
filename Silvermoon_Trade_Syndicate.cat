            <modifier field="3b25-83fd-3ecc-59c8" type="set" value="1"/>
            <modifier field="hidden" type="set" value="false"/>
          </modifiers>
        </modifierGroup>
      </modifierGroups>
      <profiles>
        <profile name="Investment Card" id="6e39-af48-995f-9b17" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">This card is recruited into any Warband with Minori.
When a Friendly model successfully Flips when using the Fortune Trait, instead of gaining double Ki Tokens, you may add an Investment Counter to this card and that model generates Ki Tokens up to its Ki Statistic as usual.
While the number of Investment Counters shown below is reached, Friendly Shatei gain the following:
1-3 Ranged Defence (+1)
4-6 Steadfast
7-9 Stun Attack (0)
10+ An additional Ki Token in the Starting Phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
