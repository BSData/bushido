      </costs>
      <rules>
        <rule name="Luck Tokens" id="8a5b-0f81-0292-f329" hidden="false">
          <description>Whenever a Friendly model within 6&quot; of a model with a Luck Token makes a Fear Test, Attack Roll, Defence Roll, Damage Roll or Opposed Ki Test the model with the Luck Token may spend the Luck Token to re-roll one of the dice.</description>
        </rule>
      </rules>
    </selectionEntry>
