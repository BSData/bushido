    <selectionEntry name="Bought Loyalty" id="5048-3a52-5689-6d0b" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Faction Event Cards" id="0537-13cd-ff3a-7baa" hidden="false" primary="true" targetId="d360-71aa-ca22-ba3c"/>
        <categoryLink name="Trap" id="f54a-3d91-6e89-42d4" hidden="false" primary="false" targetId="d190-d7ff-d350-6425"/>
      </categoryLinks>
      <constraints>
        <constraint id="83c8-9fcd-9b27-a489" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" Rice" typeId="a111-8656-5c05-7415" value="2"/>
      </costs>
      <infoLinks>
        <infoLink name="Trap" id="b165-b786-cc90-27a1" hidden="false" targetId="6ef1-a206-e5d4-b3ab" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Bought Loyalty" id="9bf4-8b54-151f-5e52" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Play when an Enemy non-Insignificant, non-Soulless model declares an action. That model must make a Ki Challenge Test (6). If it fails then its activation ends and it loses an Activation Counter.

This is a Trap effect.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Hotei&apos;s Blessing" id="5f27-0893-fa70-925c" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Faction Event Cards" id="1a53-cef0-cc99-0a8f" hidden="false" primary="true" targetId="d360-71aa-ca22-ba3c"/>
      </categoryLinks>
      <constraints>
        <constraint id="4785-0cea-e1e9-b9e0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" Rice" typeId="a111-8656-5c05-7415" value="2"/>
      </costs>
      <profiles>
        <profile name="Hotei&apos;s Blessing" id="5a1a-fa94-f0be-0adf" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Play during the Starting Phase. Until the End Phase Friendly models may reroll 1s for tests once per test.</characteristic>
          </characteristics>
        </profile>
