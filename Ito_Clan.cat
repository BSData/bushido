            <profile name="The Serpent&apos;s Kiss" id="6124-b180-5dca-0239" hidden="false" typeId="bd15-7ead-9268-3576" typeName="Special Card (Ki Feat)">
              <characteristics>
                <characteristic name="Description" typeId="17eb-17e2-4df4-5c5d">Attached model gains the Embrace the Coil Ki Feat.
Requirement [Ito Kinu]</characteristic>
                <characteristic name="Name" typeId="27c7-1649-f16e-8eaa">Embrace the Coil</characteristic>
                <characteristic name="Cost" typeId="e410-b220-64e5-7953">2</characteristic>
                <characteristic name="Timing" typeId="b9bf-562a-fe26-cb29">Simple</characteristic>
                <characteristic name="Subject" typeId="47b8-f739-9d50-2e45">Target 8&quot; Opposed</characteristic>
                <characteristic name="Limitation" typeId="870e-79e4-80ee-c0cc">Not in BtB</characteristic>
                <characteristic name="Ki Feat Description" typeId="3886-242b-fb70-5c88">Choose an Izu Serpent model that is not currently in play.
Summon and Deploy the chosen Izu Serpent model in BtB with the Target model, ignoring the usual Btb restriction on Deploying a model.
The Target gains a State Marker depending on the Izu Serpent chosen:
- Asp: Poison (2) Marker
- Boa Constrictor: Immobilised Marker
- Cobra: Blind Marker</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
