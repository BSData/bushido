            <profile name="End Phase" id="3950-b698-6bbd-aed0" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
              <characteristics>
                <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">During the End Phase, this model may make a Walk directly towards a Friendly Ninja. If this model is BtB with the chosen Ninja, that Ninja gains Tactician (+1) for the next Tactical Roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
