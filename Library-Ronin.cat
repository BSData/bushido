            <profile name="Trauma" id="728e-b1f2-2148-025a" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">In the Starting Phase, this model gains a Frightened Marker.
This model treats all Enemy models as if they have Fear (5).
While in a Melee Exchange with this model, Enemy models lose Rise and Last Stand.

This model may always recruit the Eagle Banner Enhancement - Equipment card.</characteristic>
              </characteristics>
            </profile>
            <profile name="Still Loyal" id="2406-e90d-845c-fa21" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">This model may be recruited into Shiho Themes as if it were a Faction model.
If recruited into a Shiho Theme, this model is considered a Shiho model and may have Shiho Faction Enhancements attached to it.</characteristic>
              </characteristics>
            </profile>
          </profiles>
