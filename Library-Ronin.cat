          </profiles>
        </infoGroup>
        <infoGroup name="Unique Effects" id="2f66-ba90-f7d5-a275" hidden="false">
          <infoLinks>
            <infoLink name="Heal" id="2b4d-bc1f-4c56-5137" hidden="false" targetId="bd98-52d2-3a66-08e7" type="rule"/>
            <infoLink name="Sixth Sense" id="629d-8051-04b4-feef" hidden="false" targetId="ec49-3908-f1d1-8de2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Start of Activation" id="955a-3eac-a4ab-86b0" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">At the start of this model&apos;s activation, choose 1 of the following:
- An animal in BtB with this model Heals 2 wounds.
- This model gains Sixth Sense until the End Phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="Unique Effects" id="494b-17cd-ce02-7be0" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">Warbands recruiting this model may also include Karapan as Ronin models and Ronin Bird models.
Karapan models cannot declare Melee or Charge actions against this model.
This model may be recruited into the Guerilla Warfare Theme.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
