    </selectionEntry>
    <selectionEntry name="Preordain" id="293b-d99a-c5a3-1823" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Ronin Event Cards" id="b550-4fc4-1a5a-28dd" hidden="false" primary="true" targetId="7638-6ad1-8829-91db"/>
