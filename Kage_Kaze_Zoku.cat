                <profile name="Makibishi" id="a967-3976-e5d1-18e6" hidden="false" typeId="bd15-7ead-9268-3576" typeName="Special Card (Ki Feat)">
                  <characteristics>
                    <characteristic name="Description" typeId="17eb-17e2-4df4-5c5d">Attach model gains this Ki Feat</characteristic>
                    <characteristic name="Name" typeId="27c7-1649-f16e-8eaa">Lay Makibishi</characteristic>
                    <characteristic name="Cost" typeId="e410-b220-64e5-7953">1</characteristic>
                    <characteristic name="Timing" typeId="b9bf-562a-fe26-cb29">Simple</characteristic>
                    <characteristic name="Subject" typeId="47b8-f739-9d50-2e45">Special</characteristic>
                    <characteristic name="Limitation" typeId="870e-79e4-80ee-c0cc">Not in BtB, Once Per Game</characteristic>
                    <characteristic name="Ki Feat Description" typeId="3886-242b-fb70-5c88">Deploy a Makibishi terrain element template in BtB with this model. Whenever a model without Cloudwalk or Intangible Moves into, or starts its Movement within the Makibishi terrain element, it must perform a Move Challenge Test (X).
X = 8 if the model is performing a Charge or Run Action.
X = 7 otherwise.
If unsuccessful, the model&apos;s movement and activation immediately ends.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
