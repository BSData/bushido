          <profiles>
            <profile name="All-Knowing" id="2bb0-7f66-4bc6-9fb0" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
              <characteristics>
                <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">In the End Phase, if this model is BtB with any Enemy models, those model&apos;s owners must reveal if those models are their VIM.</characteristic>
              </characteristics>
            </profile>
            <profile name="Murder" id="5ef3-6f16-42b7-2189" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">When killed, this model instead is placed Elsewhere and gains the Flank trait. It returns to play using those rules.</characteristic>
              </characteristics>
            </profile>
            <profile name="Ill Omen" id="8bfa-5192-49df-a082" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">If this model is killed by an Enemy model in a Melee Exchange or by a Ranged Attack, that Enemy model gains a Death Sentence Marker.</characteristic>
              </characteristics>
            </profile>
            <profile name="Peck" id="d5cc-c9c3-52c6-17de" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">A model Damaged by this weapon gains a Blind Marker.</characteristic>
              </characteristics>
            </profile>
            <profile name="Scry" id="35b4-e6f8-3988-15e0" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">All Ninja models have LOS to any model with a Blind Marker regardless of range, intervening models or terrain.</characteristic>
              </characteristics>
            </profile>
            <profile name="Long Shadow" id="354b-3db6-96d2-779d" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">This model may only be recruited by Warbands that have recruited the House Long Shadow Theme card.</characteristic>
              </characteristics>
            </profile>
          </profiles>
