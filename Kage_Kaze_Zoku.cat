  <selectionEntries>
    <selectionEntry name="Lockdown" id="33d5-3364-f1d4-a94c" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Faction Event Cards" id="6e3c-98ab-bd3a-7fe5" hidden="false" primary="true" targetId="d360-71aa-ca22-ba3c"/>
      </categoryLinks>
      <constraints>
        <constraint id="44fa-2894-d094-d8e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" Rice" typeId="a111-8656-5c05-7415" value="5"/>
      </costs>
      <profiles>
        <profile name="Lockdown" id="5b78-ebf2-48e0-6a0e" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Play during a Starting Phase.
Nominate either 1 Zone or 1 Scenario Objective that is on the table.
If a Zone is selected, then for that turn neither player is eligible to Control the chosen Zone, such that no Scenario Points can be scored from that Zone this turn.
If a Scenario Objective is chosen, then for that turn neither player is able to perform any Influence, Prayer, or Worship Actions at the chosen Objective. Also, for that turn no Scenario Points can be earned from the chosen Objective (irrespective of the existing alignment).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Perfect Impersonation" id="fd5f-9a83-ac5f-6aa9" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Faction Event Cards" id="d3f2-41e0-a84c-ad39" hidden="false" primary="true" targetId="d360-71aa-ca22-ba3c"/>
      </categoryLinks>
      <constraints>
        <constraint id="07e4-c03c-5cc1-f501" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" Rice" typeId="a111-8656-5c05-7415" value="7"/>
      </costs>
      <infoLinks>
        <infoLink name="Flank" id="523e-f06d-a139-438c" hidden="false" targetId="a847-f02d-7e99-8a66" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Perfect Impersonation" id="968f-4bc5-745d-ee39" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">During Deployment, 1 Ninja model gains Flank.
Play during the Starting Phase.
Remove any undamaged, non-Unique, non-VIM, Enemy model from play and replace it with a Friendly Ninja model that is Elsewhere. That Enemy model gains Flank and follows those rules to return to play in the next turn.</characteristic>
          </characteristics>
