                <characteristic name="Limitation" typeId="870e-79e4-80ee-c0cc">OpT</characteristic>
                <characteristic name="Ki Feat Description" typeId="3886-242b-fb70-5c88">When this model declares a Ranged Attack Action this model gains +1 Ranged Pool and choose one of the following until the current Ranged Attack Action is resolved:
- This model ignores Camouflage and Cover
- This model&apos;s Ranged Weapon gains Pierce (3) and Sharp (3)
- This model&apos;s Ranged Wea on cannot declare a Special Attack and gains Rapid Fire (3)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
