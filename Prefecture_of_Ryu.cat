            <profile name="Heir by Blood" id="4900-b05f-95ee-843e" hidden="false" typeId="bd15-7ead-9268-3576" typeName="Special Card (Ki Feat)">
              <characteristics>
                <characteristic name="Description" typeId="17eb-17e2-4df4-5c5d">Attached model gains the Ashigaru Type and the following Ki Feat:</characteristic>
                <characteristic name="Name" typeId="27c7-1649-f16e-8eaa">Inspiration</characteristic>
                <characteristic name="Cost" typeId="e410-b220-64e5-7953">2</characteristic>
                <characteristic name="Timing" typeId="b9bf-562a-fe26-cb29">Active</characteristic>
                <characteristic name="Subject" typeId="47b8-f739-9d50-2e45">Target 6&quot;</characteristic>
                <characteristic name="Limitation" typeId="870e-79e4-80ee-c0cc">Once Per Turn</characteristic>
                <characteristic name="Ki Feat Description" typeId="3886-242b-fb70-5c88">Target Friendly Faction model with a Rice Cost of less than this model gains +1 to its Melee Pool and Ranged Pool until the End Phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
