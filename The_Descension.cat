              <characteristics>
                <characteristic name="Description" typeId="17eb-17e2-4df4-5c5d">Attached model gains the following Ki Feat:</characteristic>
                <characteristic name="Name" typeId="27c7-1649-f16e-8eaa">Eye Peck</characteristic>
