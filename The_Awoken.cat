          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Enemy models within the area of a Webbed Ground Terrain must make a Move Challenge Test (8) or gain an Immobilised Marker.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
