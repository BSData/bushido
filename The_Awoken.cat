      <profiles>
        <profile name="Curse of Immortality" id="d7f1-1d1e-81c6-569d" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Play this card in the Starting Phase.
Choose an Enemy model. Until the End Phase, that model cannot be Killed.
If that model would have its final wound box marked, instead leave one box unmarked.
The chosen model suffers -1 to each statistic until the End Phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
