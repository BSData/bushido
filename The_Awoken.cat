          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Play this card in the Starting Phase.
Kill a Jaakuna Cultist model that you own, you may allocate four Ki Tokens amongst Friendly Kumo models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
